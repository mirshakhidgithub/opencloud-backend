# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# Frontend origin (CORS + cookies)
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Origins the browser may send on unsafe requests (the SPA, via Next's proxy).
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (docker/prod). Omit locally to use sqlite.
# DATABASE_URL=postgres://opencloud:opencloud@db:5432/opencloud

# Redis (cache + Celery)
REDIS_URL=redis://localhost:6379/0
# true in any real run: the cache holds the Zadara token vault and MFA tickets,
# which LocMemCache loses on every process restart.
USE_REDIS_CACHE=false
# CELERY_BROKER_URL=redis://redis:6379/0

# Zadara zCompute
ZADARA_API_URL=https://console.opencloud.uz
ZADARA_HTTP_TIMEOUT=15
# Simultaneous requests this process may have open to the cloud.
ZADARA_MAX_CONCURRENT_REQUESTS=12

# Zadara SERVICE (cloud-admin) account — from a secrets manager in real envs.
# Used ONLY server-side for admin overview, project listing, background sync.
ZADARA_SERVICE_ACCOUNT=
ZADARA_SERVICE_USERNAME=
ZADARA_SERVICE_PASSWORD=

# Fernet key to encrypt cached Zadara tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_VAULT_KEY=

# When the daily usage snapshot runs (UTC). Every missed day is a day that can
# never be billed, so this is the one scheduled job that matters.
BILLING_SNAPSHOT_HOUR=0
BILLING_SNAPSHOT_MINUTE=10

# --- Invoices (счёт-фактура) -------------------------------------------------
# The seller is us, so it is configuration rather than a table an account
# administrator could edit. An invoice cannot be issued while any of NAME, INN,
# ADDRESS or ACCOUNT is empty — the API refuses, not just the UI.
# VAT is off by default. Set a rate only if the invoice must carry tax; then
# PRICES_INCLUDE_VAT=false means the tariff is net and VAT is added on top.
BILLING_VAT_RATE=0
BILLING_PRICES_INCLUDE_VAT=false
BILLING_SELLER_NAME=
BILLING_SELLER_INN=
BILLING_SELLER_ADDRESS=
BILLING_SELLER_BANK=
BILLING_SELLER_ACCOUNT=
BILLING_SELLER_MFO=
BILLING_SELLER_DIRECTOR=
BILLING_SELLER_ACCOUNTANT=
BILLING_SELLER_PHONE=
BILLING_SELLER_EMAIL=
