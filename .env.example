# Values below are the LOCAL defaults; the production line is given under each
# one. Production settings refuse to start if the secret key, the vault key, the
# Redis cache or the database is left at a development value — see
# config/settings/prod.py and DEPLOY.md.

# Django
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
# Must include 127.0.0.1 (the container healthcheck probes itself by address) and,
# in docker, the compose service name **web**: the console's server-side session
# lookup calls http://web:8000/api/v1/auth/me, so without it Django answers 400
# DisallowedHost, the guard reads that as "not signed in", and every page behind
# the login bounces to /login. It fails silently and completely.
#   prod: cabinet.opencloud.uz,127.0.0.1,localhost,web
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# Frontend origin (CORS + cookies) for THIS process — the tenant cabinet. The
# admin process gets its own pair; see ADMIN_* near the bottom of this file.
#   prod: https://cabinet.opencloud.uz
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Origins the browser may send on unsafe requests (the SPA, same origin in prod).
#   prod: https://cabinet.opencloud.uz
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Where the password-reset e-mail sends people back to. Zadara sends the mail, so
# a wrong value here is a link to localhost in a real user's inbox.
#   prod: https://cabinet.opencloud.uz
FRONTEND_BASE_URL=http://localhost:3000

# Database. Omit locally to use sqlite.
#   prod: postgres://opencloud:PASSWORD@host.docker.internal:5432/opencloud
#         (Postgres runs on the host, not in the compose stack)
# DATABASE_URL=postgres://opencloud:opencloud@db:5432/opencloud

# Redis (cache + Celery). The production compose sets this to the `redis`
# service and forces USE_REDIS_CACHE=true, so neither needs setting on the server.
REDIS_URL=redis://localhost:6379/0
# true in any real run: the cache holds the Zadara token vault and MFA tickets,
# which LocMemCache loses on every process restart.
USE_REDIS_CACHE=false
# CELERY_BROKER_URL=redis://redis:6379/0

# Zadara zCompute
ZADARA_API_URL=https://console.opencloud.uz
ZADARA_HTTP_TIMEOUT=15
# Simultaneous requests this process may have open to the cloud.
ZADARA_MAX_CONCURRENT_REQUESTS=12
# Seconds a cloud list stays cached per token scope. Short on purpose: a write by
# one administrator only clears their own scope, so a colleague sees the change
# within this window.
ZADARA_RESPONSE_CACHE_TTL=45

# Zadara SERVICE (cloud-admin) account — from a secrets manager in real envs.
# Used ONLY server-side for admin overview, project listing, background sync.
ZADARA_SERVICE_ACCOUNT=
ZADARA_SERVICE_USERNAME=
ZADARA_SERVICE_PASSWORD=
# Project to scope the service token to (yields the cluster-wide read role).
ZADARA_SERVICE_PROJECT=

# How long a signed-in session lasts, in seconds. It is also the lifetime of the
# vaulted Zadara token — the cloud's tokens live ~4h and cannot be refreshed, and
# a Django session that outlives the token leaves the console rendering pages
# whose every request fails. Default 10800 (3h).
ZADARA_TOKEN_TTL=10800

# Fernet key to encrypt cached Zadara tokens at rest. REQUIRED in production —
# without it the vault derives a key from SECRET_KEY, so rotating the secret
# would silently sign every user out. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_VAULT_KEY=

# When the daily usage snapshot runs (UTC). Every missed day is a day that can
# never be billed, so this is the one scheduled job that matters. Tashkent is
# UTC+5, so 19:10 here is 00:10 local.
BILLING_SNAPSHOT_HOUR=0
BILLING_SNAPSHOT_MINUTE=10

# --- Invoices (счёт-фактура) -------------------------------------------------
# The seller is us, so it is configuration rather than a table an account
# administrator could edit. An invoice cannot be issued while any of NAME, INN,
# ADDRESS or ACCOUNT is empty — the API refuses, not just the UI.
# VAT is off by default. Set a rate only if the invoice must carry tax; then
# PRICES_INCLUDE_VAT=false means the tariff is net and VAT is added on top.
BILLING_VAT_RATE=0
BILLING_PRICES_INCLUDE_VAT=false
BILLING_SELLER_NAME=
BILLING_SELLER_INN=
BILLING_SELLER_ADDRESS=
BILLING_SELLER_BANK=
BILLING_SELLER_ACCOUNT=
BILLING_SELLER_MFO=
BILLING_SELLER_DIRECTOR=
BILLING_SELLER_ACCOUNTANT=
BILLING_SELLER_PHONE=
BILLING_SELLER_EMAIL=

# --------------------------------------------------------------------------- #
# Platform admin panel (admin-cabinet.opencloud.uz)
# --------------------------------------------------------------------------- #
# The panel's API runs as a SECOND container from this same image (`web-admin`
# in docker-compose.prod.yml), sharing this database and this Redis. The compose
# file sets PLATFORM_ADMIN_PROCESS=true for it; do not set it here, or the
# cabinet's own process would serve the admin URLconf and every tenant endpoint
# would vanish.
#
# What that flag changes: ROOT_URLCONF becomes config.urls_admin (no cabinet
# routes at all, so a routing mistake at the edge yields 404 rather than a
# tenant endpoint on the admin domain), and the session/CSRF cookies are renamed
# so the two sessions cannot collide.
#
# Loopback port for that container. The nginx upstream in the admin-tz repo has
# to say the same. 8000 is another application on this host, 8010 is the cabinet.
WEB_ADMIN_PORT=8020

# Origins for the admin process alone. It must not accept the cabinet's origin.
ADMIN_CORS_ALLOWED_ORIGINS=https://admin-cabinet.opencloud.uz
ADMIN_CSRF_TRUSTED_ORIGINS=https://admin-cabinet.opencloud.uz

# Locally, run the second process by hand next to the first:
#
#   python manage.py runserver 8000                                  # cabinet
#   PLATFORM_ADMIN_PROCESS=true \
#     CORS_ALLOWED_ORIGINS=http://localhost:3001 \
#     CSRF_TRUSTED_ORIGINS=http://localhost:3001 \
#     python manage.py runserver 8001                                # admin panel

# What the hardware actually has, so the panel can show usage as a share of
# capacity instead of a bare sum nobody can act on. Zadara does not report this,
# so it is configuration. Leave a value at 0 (or unset) and that dimension shows
# the absolute number with no percentage — better than a made-up denominator on
# a page used to decide whether to buy hardware.
PLATFORM_CAPACITY_VCPUS=0
PLATFORM_CAPACITY_RAM_MB=0
PLATFORM_CAPACITY_DISK_GB=0
